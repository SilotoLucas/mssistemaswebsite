{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [{ "type": "command", "command": "bun x --no-install biome format --write ." }]
      }
    ],
    "Stop": [
      {
        "hooks": [{ "type": "command", "command": "bun run validate:quick" }]
      }
    ]
  }
}
